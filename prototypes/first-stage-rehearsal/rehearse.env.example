# Copy to rehearse.env (git-ignored). Robot webservice credentials, created by a human in the
# Robot web UI. Never commit the filled-in file; never paste these into findings.
ROBOT_USER=
ROBOT_PASS=
# The disposable dedicated server's number (Robot → Servers → the number, not the IP).
SERVER_NUMBER=
# An ed25519 keypair used for the rescue session AND the installed system's root login.
# Generate one for this rehearsal: ssh-keygen -t ed25519 -f ~/.ssh/tau-rehearsal -N ''
SSH_KEY=$HOME/.ssh/tau-rehearsal
# Target disk inside rescue, as a stable /dev/disk/by-id/ path. Leave empty to have `install`
# list the disks and stop for you to fill it in.
DISK=
# Additional disks that ALSO get a BIOS-boot partition and GRUB (each one is ERASED): by-id paths,
# one per line inside the quotes. Leave empty for none, and then NO other disk gets a bootloader;
# the script never picks "every other disk" for you (CNF-85). Two-disk example:
#   OTHER_DISKS='/dev/disk/by-id/wwn-0x5000000000000002
#   /dev/disk/by-id/wwn-0x5000000000000003'
OTHER_DISKS=''
